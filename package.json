{
  "name": "poc-acessibilidade",
  "version": "1.0.0",
  "description": "Automação de acessibilidade web (Playwright + axe-core, WCAG 2.2 AA) com gate de CI",
  "scripts": {
    "a11y": "playwright test",
    "a11y:pages": "playwright test --project=a11y --project=a11y-mobile-reflow tests/pages.a11y.spec.ts",
    "a11y:journeys": "playwright test --project=a11y tests/journeys",
    "a11y:kbd": "playwright test --project=a11y-kbd",
    "typecheck": "tsc --noEmit",
    "a11y:baseline": "tsx scripts/update-baseline.ts",
    "a11y:report": "tsx scripts/report.ts && tsx scripts/wcag-docs.ts"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "axe-core": "4.14.0",
    "dotenv": "18.0.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
