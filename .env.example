# Copie para .env (que NÃO vai para o git) e preencha localmente.
# No GitLab CI, estes valores vêm de Settings → CI/CD → Variables.

# Alvo dos scans. Vazio = páginas de demo/ servidas localmente.
BASE_URL=

# Usuário de teste para páginas com requiresAuth (no CI: masked + protected).
A11Y_USER=
A11Y_PASSWORD=

# Modo do gate: report | critical | serious
A11Y_GATE_MODE=report

# Porta do servidor local de demo/ (opcional).
# DEMO_PORT=4173
